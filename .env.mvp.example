# Local, private MVP. Fake tools only. Model download is a separate explicit step.
MECHA_PROVIDER=mock
MECHA_TENANT_KEYS='{"demo":{"key":"fake-local-demo-key","role":"admin","platform_admin":true}}'
MECHA_AUDIT_PATH=artifacts/audit.sqlite
MECHA_STATE_PATH=artifacts/state.sqlite
MECHA_AGENT_PROVIDER=llamacpp
MECHA_AGENT_MODEL=Qwen2.5-7B-Instruct
MECHA_ALLOW_NETWORK=1
MECHA_LOCAL_URL=http://127.0.0.1:8081/v1
MECHA_DASHBOARD_PATH=dashboard/dist
HF_HUB_OFFLINE=1
HF_DATASETS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
OMP_NUM_THREADS=4
